---
import { Picture } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import { services } from "@/data/site";
---

<section id="services" aria-labelledby="services-title" class="bg-card py-24 md:py-28">
  <div class="container-site">
    <SectionHeading
      id="services-title"
      kicker="Build Your Dream"
      title="Quality Services"
      action={{ label: "Get a quote", href: "#contact" }}
    />

    <ul data-reveal="stagger" class="mt-14 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {services.map(({ title, description, image, alt }) => (
        <li class="group">
          <div class="overflow-hidden">
            <Picture
              src={image}
              alt={alt}
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 23rem, (min-width: 640px) 50vw, 100vw"
              formats={["avif", "webp"]}
              class="aspect-[380/250] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none"
            />
          </div>
          <h3 class="font-display mt-7 text-2xl text-secondary">{title}</h3>
          <p class="mt-3 text-muted-foreground">{description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
