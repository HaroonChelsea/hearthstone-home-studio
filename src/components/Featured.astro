---
import { Picture } from "astro:assets";
import { CalendarCheckIcon, GemIcon, MessagesSquareIcon, RulerIcon } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import featured from "@/assets/images/featured.jpg";
import craft from "@/assets/images/service-carpentry.jpg";

const practices = [
  { icon: RulerIcon, label: "Detailed Planning" },
  { icon: CalendarCheckIcon, label: "Projects On Schedule" },
  { icon: GemIcon, label: "Premium Materials" },
  { icon: MessagesSquareIcon, label: "Clear Communication" },
];
const photo = "absolute inset-0 -z-20 size-full object-cover";
---

<section aria-labelledby="featured-title" class="grid lg:grid-cols-2">
  <div class="dark relative isolate flex items-center overflow-hidden px-5 py-24 text-foreground md:px-12 lg:py-32 lg:ps-[max(2rem,calc((100vw-75rem)/2+2rem))] lg:pe-16">
    <Picture src={featured} alt="" widths={[480, 640, 720, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" formats={["avif", "webp"]} class={photo} />
    <div class="absolute inset-0 -z-10 bg-[rgb(22_34_56/0.88)]" aria-hidden="true"></div>
    <div data-reveal="left" class="max-w-[30rem]">
      <p class="font-heading text-[clamp(1.25rem,1rem+0.8vw,1.75rem)] font-light text-primary">Featured Project</p>
      <h2 id="featured-title" class="font-display mt-3 text-[clamp(1.875rem,1.4rem+1.6vw,2.75rem)] leading-[1.2]">
        Designed For Modern Living
      </h2>
      <p class="mt-5 text-muted-foreground">
        Every renovation is carefully planned around your lifestyle, needs, and vision.
      </p>
      <a href="#projects" class={cn(buttonVariants({ size: "lg" }), "mt-10 h-14 px-9")}>View projects</a>
    </div>
  </div>

  <div class="relative isolate flex items-center overflow-hidden px-5 py-24 text-primary-foreground md:px-12 lg:py-32 lg:ps-16 lg:pe-[max(2rem,calc((100vw-75rem)/2+2rem))]">
    <Picture src={craft} alt="" widths={[480, 640, 720, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" formats={["avif", "webp"]} class={photo} />
    <div class="absolute inset-0 -z-10 bg-primary/92" aria-hidden="true"></div>
    <div data-reveal="right" class="max-w-[30rem]">
      <h3 class="font-display text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-[1.25]">How Every Project Runs</h3>
      <p class="mt-4">One designer and one project manager stay with you from the first sketch to the final walkthrough.</p>
      <ul class="mt-8 flex flex-col gap-5">
        {practices.map(({ icon: Icon, label }) => (
          <li class="font-heading flex items-center gap-4 text-xl font-bold">
            <Icon className="size-6 shrink-0" aria-hidden="true" />
            {label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
