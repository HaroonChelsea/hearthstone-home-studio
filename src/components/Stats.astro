---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { stats } from "@/data/site";
---

<section aria-labelledby="stats-title" class="container-site relative z-10 -mt-24">
  <div data-reveal class="grid shadow-[26px_18px_81px_0_rgb(22_34_56/0.12)] lg:grid-cols-2">
    <div class="flex flex-col items-start bg-primary p-8 text-primary-foreground md:p-12 lg:py-14">
      <p class="font-heading text-[clamp(1.25rem,1rem+0.8vw,1.75rem)] font-light">Build Your Dream</p>
      <h2 id="stats-title" class="font-display mt-3 text-[clamp(1.75rem,1.2rem+1.6vw,2.375rem)] leading-[1.15]">
        25 Years Of Creating Beautiful Homes
      </h2>
      <p class="mt-5 max-w-[26rem]">
        We combine thoughtful design, quality materials, and expert craftsmanship.
      </p>
      <a href="#contact" class={cn(buttonVariants({ variant: "secondary", size: "lg" }), "mt-10 h-14 px-9")}>Work with us</a>
    </div>

    <dl class="grid grid-cols-2 bg-card">
      {stats.map(({ value, label }) => (
        <div class="flex flex-col-reverse justify-center gap-2 border-e border-b p-6 even:border-e-0 nth-[n+3]:border-b-0 md:p-10">
          <dt class="text-muted-foreground">{label}</dt>
          <dd class="font-display text-[clamp(2.25rem,1.5rem+2.4vw,3.5rem)] leading-none text-secondary">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
